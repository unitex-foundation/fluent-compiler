{
  "name": "@unitex/fluent-compiler",
  "description": "Compiler from TypeScript to Fluent Translation List (FTL)",
  "author": {
    "name": "Grigorii Lutkov",
    "email": "friend.lga@gmail.com"
  },
  "version": "0.0.1",
  "homepage": "https://trulab.ru/unitex/fluent-compiler",
  "repository": {
    "type": "git",
    "url": "https://trulab.ru/unitex/fluent-compiler.git"
  },
  "bugs": {
    "url": "https://trulab.ru/unitex/fluent-compiler/-/issues"
  },
  "license": "MIT",
  "scripts": {
    "build": "rm -rf dist/ && tsc --project tsconfig_build.json && tsc-alias -p tsconfig_build.json",
    "lint": "eslint --cache --rule 'import/order: [warn, { newlines-between: never }]' --ext=js,mjs,cjs,ts,mts,cts,d.ts",
    "lint_all": "yarn lint './**/*.{js,mjs,cjs,ts,mts,cts,d.ts}'",
    "lint_fix": "yarn lint --fix",
    "lint_fix_all": "yarn lint_all --fix",
    "format": "prettier --ignore-unknown --check",
    "format_all": "yarn format ./",
    "format_fix": "yarn format --write",
    "format_fix_all": "yarn format_all --write",
    "lint_format_fix_all": "yarn lint_fix_all && yarn format_fix_all",
    "test": "bun scripts/test.ts"
  },
  "exports": {
    ".": {
      "node": {
        "types": "./dist/back/main_back.d.ts",
        "default": "./dist/back/main_back.js"
      },
      "default": {
        "types": "./dist/front/main_front.d.ts",
        "default": "./dist/front/main_front.js"
      }
    },
    "./*": {
      "types": "./dist/*.d.ts",
      "default": "./dist/*.js"
    }
  },
  "files": [
    "dist/",
    "third_party_licenses/",
    "CONTRIBUTORS.md",
    "COPYING.md",
    "COPYRIGHT.md",
    "LICENSE.md",
    "README.md",
    "third_party_licenses.md"
  ],
  "dependencies": {
    "@fluent/bundle": "^0.19.0",
    "@fluent/dedent": "^0.5.0",
    "@fluent/langneg": "^0.7.0"
  },
  "devDependencies": {
    "@stylistic/eslint-plugin": "4.4.1",
    "@types/bun": "1",
    "@types/node": "22.18.0",
    "@typescript-eslint/parser": "8.34.1",
    "bun": "1.2.17",
    "eslint": "9.29.0",
    "eslint-import-resolver-typescript": "4.4.3",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-unused-imports": "4.1.4",
    "globals": "16.2.0",
    "prettier": "3.5.3",
    "tsc-alias": "1.8.16",
    "typescript": "5.8.3",
    "typescript-eslint": "8.34.1"
  },
  "type": "module",
  "packageManager": "yarn@4.12.0"
}
