{
  "name": "@unitex/fluent-compiler",
  "description": "Compiler from TypeScript to Fluent Translation List (FTL)",
  "author": {
    "name": "Grigorii Lutkov",
    "email": "grigorii@lutkov.dev"
  },
  "version": "1.0.1",
  "homepage": "https://trulab.ru/unitex/fluent-compiler",
  "repository": {
    "type": "git",
    "url": "git+https://trulab.ru/unitex/fluent-compiler.git"
  },
  "bugs": {
    "url": "https://trulab.ru/unitex/fluent-compiler/-/issues"
  },
  "license": "MIT",
  "scripts": {
    "build": "rm -rf dist/ && tsc && tsc-alias",
    "lint": "eslint --cache --rule 'import/order: [warn, { newlines-between: never }]' --ext=js,mjs,cjs,ts,mts,cts,d.ts",
    "lint_all": "bun run lint './**/*.{js,mjs,cjs,ts,mts,cts,d.ts}'",
    "lint_fix": "bun run lint --fix",
    "lint_fix_all": "bun run lint_all --fix",
    "format": "prettier --ignore-unknown --check",
    "format_all": "bun run format ./",
    "format_fix": "bun run format --write",
    "format_fix_all": "bun run format_all --write",
    "lint_format_fix_all": "bun run lint_fix_all && bun run format_fix_all",
    "test": "bun example/example.ts"
  },
  "exports": {
    ".": {
      "node": {
        "types": "./dist/back/main_back.d.ts",
        "default": "./dist/back/main_back.js"
      },
      "default": {
        "types": "./dist/front/main_front.d.ts",
        "default": "./dist/front/main_front.js"
      }
    },
    "./*": {
      "types": "./dist/*.d.ts",
      "default": "./dist/*.js"
    }
  },
  "files": [
    "dist/",
    "third_party_licenses/",
    "CONTRIBUTORS.md",
    "COPYING.md",
    "COPYRIGHT.md",
    "LICENSE.md",
    "README.md",
    "third_party_licenses.md"
  ],
  "dependencies": {
    "@fluent/bundle": "0.19.*",
    "@fluent/dedent": "0.5.*",
    "@fluent/langneg": "0.7.*"
  },
  "devDependencies": {
    "@stylistic/eslint-plugin": "5.10.0",
    "@types/bun": "1.4.2",
    "@types/node": "26.0.0",
    "@typescript-eslint/parser": "8.70.1",
    "bun": "1.4.2",
    "eslint": "10.11.0",
    "eslint-import-resolver-typescript": "4.4.5",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-unused-imports": "4.4.1",
    "globals": "17.12.0",
    "prettier": "3.9.9",
    "tsc-alias": "1.9.5",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.1"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "v26.0.0",
      "onFail": "warn"
    },
    "packageManager": {
      "name": "bun",
      "version": "1.4.2",
      "onFail": "warn"
    }
  },
  "type": "module",
  "keywords": [
    "fluent",
    "compiler",
    "transpiler",
    "i18n",
    "l10n",
    "internationalization",
    "internationalisation",
    "localization",
    "localisation",
    "translation",
    "language",
    "frontend",
    "backend"
  ]
}
